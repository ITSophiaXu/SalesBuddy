HOST=127.0.0.1
PORT=4173
NODE_ENV=development
AI_PROVIDER=copilot
# Optional: leave blank to use the Copilot service default model.
COPILOT_MODEL=
# Optional absolute path when copilot is not on the service user's PATH.
COPILOT_CLI_PATH=
# Prefer the service user's existing Copilot login. If a token is required,
# supply COPILOT_GITHUB_TOKEN or GH_TOKEN in a private server environment file.
COPILOT_TIMEOUT_MS=120000
MOTIVE_MAX_CONCURRENT=2
# Required for production. HTTPS domain, or HTTP loopback for an SSH tunnel.
PUBLIC_ORIGIN=http://127.0.0.1:4173
# Use none only with an HTTP loopback origin reached through an SSH tunnel.
MOTIVE_AUTH_MODE=password
# Required for production; preferably use a 0600 file outside the web directory.
MOTIVE_PASSWORD_FILE=
# Optional instead of PASSWORD_FILE; do not commit a real password.
MOTIVE_PASSWORD=
